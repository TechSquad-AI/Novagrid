import ollama


def clean_ai_output(result):
    """
    Clean Ollama output so only usable Python code remains.
    """

    result = result.strip()

    # Remove markdown code fences
    if result.startswith("```"):
        lines = result.splitlines()

        if lines and lines[0].strip().startswith("```"):
            lines = lines[1:]

        if lines and lines[-1].strip() == "```":
            lines = lines[:-1]

        result = "\n".join(lines).strip()

    # Remove accidental explanation
    if result.startswith("Corrected code:"):
        result = result[len("Corrected code:"):].strip()

    if result.startswith("Replacement:"):
        result = result[len("Replacement:"):].strip()

    return result


def generate_fix(
    old_field,
    new_field,
    affected_code
):
    """
    Generate a minimal replacement expression using Ollama.
    """

    prompt = f"""
You are NovaGrid, an autonomous API maintenance agent.

An API contract has changed.

Removed API field:
{old_field}

New API field:
{new_field}

Affected code:
{affected_code}

Your task is to replace the removed API field with the new API field.

Example:

Removed field:
status

New field:
result

Affected code:
data["result"]

Correct replacement:
data["result"]

Rules:
1. Return ONLY the replacement expression.
2. Do NOT return explanations.
3. Do NOT return markdown.
4. Do NOT use ```python.
5. Do NOT include "return".
6. Do NOT modify unrelated code.
7. Preserve the existing variable name.
8. If the affected code is data["result"], return data["result"].
"""

    try:
        response = ollama.chat(
            model="qwen2.5-coder:3b",
            messages=[
                {
                    "role": "user",
                    "content": prompt
                }
            ]
        )

        result = response["message"]["content"]

        result = clean_ai_output(result)

        return result

    except Exception as error:
        print(
            f"[NovaGrid] Ollama error: {error}"
        )

        return None


if __name__ == "__main__":

    result = generate_fix(
        "status",
        "result",
        'data["result"]'
    )

    print(result)