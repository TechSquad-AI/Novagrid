import os
import ast


PROJECT_ROOT = os.path.dirname(
    os.path.abspath(__file__)
)


IGNORE_DIRS = {
    "venv",
    "__pycache__",
    ".git"
}


TARGET_VARIABLES = {
    "response",
    "data",
    "result",
    "json_data",
    "payload"
}


def find_api_field_usage(field_name):

    results = []

    for root, dirs, files in os.walk(PROJECT_ROOT):

        dirs[:] = [
            d for d in dirs
            if d not in IGNORE_DIRS
        ]

        for file in files:

            if not file.endswith(".py"):
                continue

            file_path = os.path.join(
                root,
                file
            )

            try:

                with open(
                    file_path,
                    "r",
                    encoding="utf-8"
                ) as f:

                    source = f.read()


                tree = ast.parse(source)


                for node in ast.walk(tree):


                    # ---------------------------------
                    # Detect:
                    # response["result"]
                    # data["status"]
                    # result["status"]
                    # ---------------------------------

                    if isinstance(
                        node,
                        ast.Subscript
                    ):

                        if isinstance(
                            node.value,
                            ast.Name
                        ):

                            variable = node.value.id


                            if variable in TARGET_VARIABLES:

                                key = None


                                if isinstance(
                                    node.slice,
                                    ast.Constant
                                ):

                                    key = node.slice.value


                                if key == field_name:

                                    results.append(
                                        {
                                            "file":
                                                file_path,

                                            "line":
                                                node.lineno,

                                            "code":
                                                source.splitlines()[
                                                    node.lineno - 1
                                                ].strip()
                                        }
                                    )


                    # ---------------------------------
                    # Detect:
                    # response.get("status")
                    # data.get("status")
                    # ---------------------------------

                    if isinstance(
                        node,
                        ast.Call
                    ):

                        if isinstance(
                            node.func,
                            ast.Attribute
                        ):

                            if node.func.attr == "get":

                                if isinstance(
                                    node.func.value,
                                    ast.Name
                                ):

                                    variable = (
                                        node.func.value.id
                                    )


                                    if variable in TARGET_VARIABLES:


                                        if len(node.args) > 0:

                                            argument = node.args[0]


                                            if isinstance(
                                                argument,
                                                ast.Constant
                                            ):

                                                if (
                                                    argument.value
                                                    ==
                                                    field_name
                                                ):

                                                    results.append(
                                                        {
                                                            "file":
                                                                file_path,

                                                            "line":
                                                                node.lineno,

                                                            "code":
                                                                source.splitlines()[
                                                                    node.lineno - 1
                                                                ].strip()
                                                        }
                                                    )


            except Exception:

                continue


    return results